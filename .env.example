# MongoDB connection URL used by the ingestor service.
MONGO_URL=mongodb://db:27017
# Database name where spots are stored.
DB_NAME=spider_spots
# Collection name used to save spot documents.
COLLECTION_NAME=spots

# Initial DX cluster source, only used on first start. Afterwards, manage sources at /admin.
# DX cluster host to connect to (local or remote).
DX_HOST=localhost
# DX cluster TCP port.
DX_PORT=7300
# Optional backup DX clusters (comma separated, host or host:port), tried in order when
# the current node fails FAILOVER_ATTEMPTS times in a row.
#DX_HOST_BACKUP=backup1.example.net,backup2.example.net:7300
#DX_PORT_BACKUP=7300
# Callsign used to authenticate/login in the DX cluster.
CALLSIGN=YOUR_CALLSIGN

# Initial admin user for /admin, only used when there are no users yet.
# If ADMIN_PASSWORD is empty, a random password is printed once in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# JWT signing secret. If unset, a random one is generated and stored in SQLite.
SECRET_KEY=CHANGE_THIS_KEY_IN_PRODUCTION
# Legacy password-only login (read-only API token). Leave empty to disable.
API_PASSWORD=

# Host interface where the Fastify API server listens.
SERVER_HOST=0.0.0.0
# Port where the Fastify API server listens.
SERVER_PORT=3000

# Number of spots buffered before doing a batch insert.
BUFFER_LIMIT=15
# Spot retention time in seconds (MongoDB TTL index).
TTL_SECONDS=604800
# Delay in milliseconds before reconnecting after socket disconnection.
RECONNECT_DELAY_MS=10000
# Consecutive failures before switching between primary and backup nodes.
FAILOVER_ATTEMPTS=3
# How often (ms) to check if the primary is back while connected to the backup.
PRIMARY_CHECK_INTERVAL_MS=300000
# Timeout (ms) when opening the connection to the DX cluster.
CONNECT_TIMEOUT_MS=15000
# Reconnect if no data is received from the cluster for this long (ms).
INACTIVITY_TIMEOUT_MS=300000
